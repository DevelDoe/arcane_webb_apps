{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcane Webb Apps",
  "version": "0.1.0",
  "identifier": "com.develdoe.arcanewebbapps",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../frontend" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" },
    "devUrl": "http://localhost:1423",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arcane Webb Apps",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Turn websites into focused desktop apps",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
