{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "web-app-window-dragging",
  "description": "Allows remote web-app windows to invoke only the native drag operation",
  "remote": {
    "urls": ["https://*", "http://*"]
  },
  "local": false,
  "windows": ["web-app-*"] ,
  "permissions": [
    "core:window:allow-start-dragging"
  ]
}
